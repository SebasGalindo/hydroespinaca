# ------------------------------
# Global .env ignores (anywhere in the repo)
# ------------------------------
**/.env
**/.env.*
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
*.swp

# ------------------------------
# Node / React / Vite / Preact
# ------------------------------
**/node_modules/
**/dist/
**/.vite/
**/.turbo/
**/.eslintcache
**/.parcel-cache/

# ------------------------------
# React Native / Expo
# ------------------------------
**/ios/
**/android/
**/web-build/
**/expo-shared/
**/.expo/
**/.expo-shared/
**/.expo-cache/
**/.expo-settings/
**/build/

# ------------------------------
# Python (fuzzy-service)
# ------------------------------
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/env/
**/venv/
**/.venv/
**/.ipynb_checkpoints/

# ------------------------------
# .NET Core / C# (microservices)
# ------------------------------
**/bin/
**/obj/
**/*.user
**/*.suo
**/*.vspscc
**/*.vssscc
**/*.csproj.user
**/TestResults/
**/.vs/

# ------------------------------
# IDEs & editors
# ------------------------------
**/.idea/
**/.vscode/
*.code-workspace

# ------------------------------
# Docker / Compose / Volumes
# ------------------------------
**/db/volume/
**/docker-data/
**/deploy/mosquitto/data/
**/docker-compose.override.yml

# ------------------------------
# Shared / Libraries / Output
# ------------------------------
**/packages/shared-ui/dist/
**/packages/**/lib/
**/packages/**/build/

# ------------------------------
# Secrets and sensitive files
# ------------------------------
**/private.key
**/public.key
**/secrets.json
**/*.pem
**/*.crt
**/*.cert
**/*.enc
**/auth.json
**/credentials.json

# ------------------------------
# Mosquitto (Broker MQTT)
# ------------------------------
**/mosquitto/config/pwfile
**/mosquitto/config/passwd
**/mosquitto/passwd
