# ------------------------------
# Global ignores
# ------------------------------
.env
.env.*              # .env.local, .env.production, etc.
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
*.swp

# ------------------------------
# Node / React / Vite
# ------------------------------
**/node_modules/
**/dist/
**/.vite/
**/.turbo/
**/.eslintcache

# ------------------------------
# React Native / Expo (mobile-app)
# ------------------------------
**/ios/
**/android/
**/web-build/
**/expo-shared/
**/.expo/
**/.expo-shared/
**/build/             # expo export
**/.expo-cache/
**/.expo-settings/

# ------------------------------
# Python (fuzzy-service)
# ------------------------------
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/env/
**/venv/

# ------------------------------
# .NET Core (microservices)
# ------------------------------
**/bin/
**/obj/
**/*.user
**/*.suo
**/*.vspscc
**/*.vssscc

# ------------------------------
# IDEs & editors
# ------------------------------
.idea/
.vscode/
*.code-workspace

# ------------------------------
# Docker / Volumes / Compose
# ------------------------------
db/volume/
deploy/mosquitto/data/
docker-compose.override.yml

# ------------------------------
# Shared / Build outputs
# ------------------------------
packages/shared-ui/dist/

# ------------------------------
# Secrets and private keys
# ------------------------------
**/private.key
**/public.key
**/secrets.json
