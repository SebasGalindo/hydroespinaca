{
  "name": "@hidroespinaca/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Código compartido entre aplicaciones web y móvil del sistema hidropónico",
  "main": "./dist/index.web.js",
  "module": "./dist/index.web.esm.js",
  "types": "./dist/index.web.d.ts",
  "react-native": "./dist/index.native.js",
  "exports": {
    ".": {
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.web.esm.js",
      "require": "./dist/index.web.js",
      "types": "./dist/index.web.d.ts",
      "default": "./dist/index.web.js"
    },
    "./hooks": {
      "react-native": "./dist/hooks/index.native.js",
      "import": "./dist/hooks/index.web.esm.js",
      "require": "./dist/hooks/index.web.js",
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.web.js"
    },
    "./store": {
      "react-native": "./dist/store/index.native.js",
      "import": "./dist/store/index.web.esm.js",
      "require": "./dist/store/index.web.js",
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.web.js"
    },
    "./utils": {
      "react-native": "./dist/utils/index.native.js",
      "import": "./dist/utils/index.web.esm.js",
      "require": "./dist/utils/index.web.js",
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.web.js"
    },
    "./types": {
      "react-native": "./dist/types/index.native.js",
      "import": "./dist/types/index.web.esm.js",
      "require": "./dist/types/index.web.js",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.web.js"
    },
    "./api": {
      "react-native": "./dist/api/index.native.js",
      "import": "./dist/api/index.web.esm.js",
      "require": "./dist/api/index.web.js",
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.web.js"
    },
    "./icons": {
      "react-native": "./dist/icons/index.native.js",
      "import": "./dist/icons/index.web.esm.js",
      "require": "./dist/icons/index.web.js",
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.web.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && rollup -c",
    "dev": "pnpm clean && rollup -c -w",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.8",
    "@types/node": "^20",
    "eslint": "^9",
    "expo-secure-store": "^13.0.2",
    "jest": "^29.7.0",
    "react-native-svg": "^15.8.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-native": ">=0.70.0",
    "@react-native-async-storage/async-storage": "^1.0.0",
    "react-native-svg": ">=13.0.0",
    "expo-secure-store": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    }
  },
  "keywords": [
    "shared",
    "utilities",
    "hooks",
    "store",
    "types",
    "hidroponía",
    "react",
    "react-native"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tu-usuario/hidroespinaca-monorepo.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/hidroespinaca-monorepo/issues"
  },
  "homepage": "https://github.com/tu-usuario/hidroespinaca-monorepo/tree/main/packages/shared#readme"
}