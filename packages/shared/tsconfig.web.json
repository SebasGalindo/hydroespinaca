{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/web",
    "rootDir": "./src",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "src/types/global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    // Exclude native-specific files
    "src/**/*.native.ts",
    "src/**/*.native.tsx",
    "src/icons/Icon.tsx",
    "src/icons/index.ts",
    "src/utils/index.ts",
    "src/index.ts"
  ]
}
