{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "placeholder-will-be-overridden-by-env",
    "Database": "HydroEspinacaDB"
  },
  "Email": {
    "FromEmail": "placeholder-will-be-overridden-by-env",
    "FromName": "HydroEspinaca",
    "Provider": "Resend",
    "Resend": {
      "ApiBaseUrl": "https://api.resend.com",
      "ApiKey": "placeholder-will-be-overridden-by-env"
    },
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true,
      "Username": "placeholder-will-be-overridden-by-env",
      "Password": "placeholder-will-be-overridden-by-env"
    }
  },
  "Push": {
    "WebPush": {
      "VapidSubject": "mailto:placeholder@example.com",
      "VapidPublicKey": "placeholder-will-be-overridden-by-env",
      "VapidPrivateKey": "placeholder-will-be-overridden-by-env"
    },
    "Expo": {
      "ApiUrl": "https://exp.host/--/api/v2/push/send"
    }
  },
  "WhatsApp": {
    "Enabled": false,
    "Twilio": {
      "AccountSid": "placeholder-will-be-overridden-by-env",
      "AuthToken": "placeholder-will-be-overridden-by-env",
      "FromNumber": "placeholder-will-be-overridden-by-env"
    }
  },
  "M2M": {
    "ClientId": "placeholder-will-be-overridden-by-env",
    "ClientSecret": "placeholder-will-be-overridden-by-env",
    "AuthServiceUrl": "http://auth-service:8080",
    "TokenEndpoint": "/api/auth/token",
    "TokenCacheDurationMinutes": 50
  },
  "Services": {
    "SensorServiceUrl": "http://sensor-service:8080",
    "ActuatorServiceUrl": "http://actuator-service:8080",
    "FuzzyServiceUrl": "http://fuzzy-service:8080",
    "WeatherServiceUrl": "http://weather-service:8080"
  }
}