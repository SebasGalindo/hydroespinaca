<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ model.subject | default: "HydroEspinaca" }}</title>
    <style>
      body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;margin:0;padding:24px;background:#f6f7fb;color:#111}
      .container{max-width:640px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;border:1px solid #e6e8ee}
      .header{padding:16px 20px;background:#0ea5e9;color:#fff;font-weight:600}
      .content{padding:24px}
      .footer{padding:16px 20px;color:#6b7280;font-size:12px;border-top:1px solid #f0f2f6}
      @media (prefers-color-scheme: dark){ body{background:#0b0f1a;color:#e5e7eb} .container{background:#0f172a;border-color:#1f2937} .footer{border-color:#1f2937} }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">HydroEspinaca</div>
      <div class="content">
        {{ body | raw }}
      </div>
      <div class="footer">Este es un correo automático. No respondas a este mensaje.</div>
    </div>
  </body>
</html>
