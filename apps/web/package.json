{
  "name": "@hidroespinaca/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aplicación web del sistema de monitoreo hidropónico",
  "scripts": {
    "dev": "next dev --turbo --hostname 0.0.0.0",
