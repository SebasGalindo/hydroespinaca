{
  "expo": {
    "name": "HydroEspinaca",
    "slug": "hydroespinaca",
    "version": "1.0.0",
    "scheme": "hydroespinaca",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "description": "Sistema de monitoreo y control hidropónico inteligente. Supervisa las variables ambientales de tu cultivo hidropónico de espinaca, con control automatizado basado en lógica difusa.",
    "platforms": [
      "android"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16a34a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hydroespinaca.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16a34a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.hydroespinaca.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "7f25aee2-3628-4b58-a4f2-f33581ec51b7"
      }
    },
    "owner": "zurditoman"
  }
}
