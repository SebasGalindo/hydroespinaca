{
  "name": "@hydroespinaca/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "pnpm exec expo start",
    "start:clean": "pnpm exec expo start --clear",
    "start:tunnel": "pnpm exec expo start --tunnel --clear",
    "start:lan": "pnpm exec expo start --lan --clear",
    "start:dev": "pnpm exec expo start --dev-client -c",
    "android": "pnpm exec expo run:android",
    "android:debug": "pnpm exec expo run:android --variant debug",
    "ios": "pnpm exec expo run:ios",
    "web": "pnpm exec expo start --web",
    "type-check": "tsc --noEmit",
    "prebuild:clean": "pnpm exec expo prebuild --clean",
    "clean:cache": "rm -rf .expo && rm -rf node_modules/.cache",
    "clean:all": "rm -rf .expo && rm -rf node_modules && rm -rf node_modules/.cache",
    "rebuild": "pnpm clean:cache && cd ../../packages/shared && pnpm build && cd - && pnpm start:clean",
    "build:shared": "cd ../../packages/shared && pnpm build",
    "eas-build-pre-install": "node -e \"const {execSync} = require('child_process'); execSync('cd ../../packages/shared && pnpm install && pnpm build', {stdio: 'inherit'})\"",
    "doctor": "pnpm exec expo doctor",
    "doctor:fix": "pnpm exec expo install --fix",
    "precheck": "pnpm exec tsc --noEmit && pnpm dlx depcheck && pnpm exec expo-doctor"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hydroespinaca/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "^5.0.1",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.2",
    "expo": "~54.0.33",
    "expo-asset": "12.0.12",
    "expo-constants": "18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "19.0.21",
    "expo-font": "14.0.11",
    "expo-haptics": "^15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.74",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.17",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-appwrite": {
      "expo-file-system": "18.*.*",
      "react-native": ">=0.76.7 <1.0.0"
    }
  }
}
