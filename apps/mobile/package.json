{
  "name": "@hidroespinaca/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client -c",
    "android": "expo run:android",
    "android:debug": "expo run:android --variant debug",
    "ios": "expo run:ios",
