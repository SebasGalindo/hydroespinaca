# Version Control
.git
.gitignore

# IDE and Editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
jspm_packages/

# Build outputs and dist directories
dist/
build/
out/
target/
bin/
obj/

# Environment files (keep .env in some cases but avoid others)
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS generated files
Thumbs.db
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Dependency package locks (optional, keep if needed for reproducibility)
# package-lock.json
# yarn.lock

# Documentation
docs/
*.md

# Test files (optional)
test/
tests/
__tests__/
*.test.js
*.spec.js

# ESLint and other config files (optional)
.eslintrc*
.prettierrc*

# Certificates and secrets
*.pem
*.key
*.crt
*.p12
secrets/

# Cache directories
.cache/
.next/cache/
.nuxt/
.vuepress/dist

# Backup files
*.bak
*.backup

# Large media files
*.mp4
*.avi
*.mkv
*.mov
*.wmv
*.flv
*.webm
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.svg
*.ico
*.tiff
*.tif
*.webp

# Archives
*.zip
*.rar
*.tar
*.tar.gz
*.7z
*.dmg
*.iso

# Database files
*.db
*.sqlite
*.sqlite3

# Docker related files we want to keep in root but exclude from subdirectories
**/Dockerfile
**/docker-compose*.yml
**/.dockerignore

# Keep necessary config files at root but ignore in subdirs
!Dockerfile
!docker-compose.yml
!.dockerignore